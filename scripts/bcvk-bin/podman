#!/usr/bin/env bash
# ABOUTME: Removes bcvk's host-DNS argument when its outer network is none.
set -euo pipefail

args=("$@")
network_none=0
for ((index = 0; index < ${#args[@]}; index++)); do
    if [[ "${args[index]}" == '--network=none' ]] || \
            [[ "${args[index]}" == '--network' && \
                "${args[index + 1]:-}" == 'none' ]]; then
        network_none=1
        break
    fi
done

if ((network_none)); then
    filtered=()
    skip_next=0
    for argument in "${args[@]}"; do
        if ((skip_next)); then
            skip_next=0
            continue
        fi
        if [[ "${argument}" == '--dns' ]]; then
            skip_next=1
            continue
        fi
        [[ "${argument}" == --dns=* ]] && continue
        filtered+=("${argument}")
    done
    args=("${filtered[@]}")
fi

exec /usr/bin/podman "${args[@]}"

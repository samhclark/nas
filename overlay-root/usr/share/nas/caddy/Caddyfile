{
	acme_dns cloudflare {file./run/secrets/cf-api-token}
	email no-reply@samhclark.com

	metrics {
		per_host
	}

	# The admin listener is published only on host loopback by the Quadlet.
	admin 0.0.0.0:2019

	# Let's Encrypt Staging Endpoint, for testing
	#acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Management UIs are reachable from the LAN and Tailscale, but never from the
# public Internet.  The snippet argument is the service's krun endpoint.
(private-ingress) {
	@private remote_ip private_ranges 100.64.0.0/10
	handle @private {
		reverse_proxy {args[0]}
	}
	respond 403
}

# Garage S3-compatible object storage
# Admin API - for garage CLI and metrics
garage.i.samhclark.com {
	reverse_proxy garage.krun:3903
}

# S3 API - supports both path-style and virtual-hosted style
# Path style: s3.i.samhclark.com/bucket/key
# Virtual-hosted: bucket.s3.i.samhclark.com/key
s3.i.samhclark.com, *.s3.i.samhclark.com {
	reverse_proxy garage.krun:3900
}

# VictoriaLogs - logs database and web UI
logs.i.samhclark.com {
	reverse_proxy victoria-logs.krun:9428
}

# VictoriaMetrics - time series database and web UI
metrics.i.samhclark.com {
	reverse_proxy victoria-metrics.krun:8428
}

# Grafana - dashboards and visualization
visualize.i.samhclark.com {
	reverse_proxy grafana.krun:3000
}

# Jellyfin - media library and streaming
jellyfin.i.samhclark.com {
	reverse_proxy jellyfin.krun:8096
}

# Immich - private photo and video library
photos.i.samhclark.com {
	reverse_proxy immich-server.krun:2283
}


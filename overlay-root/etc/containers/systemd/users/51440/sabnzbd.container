AddHost=radarr.krun:10.253.15.2
AddHost=prowlarr.krun:10.253.16.2
AddHost=sabnzbd.krun:10.253.17.2
AddHost=host.krun.internal:10.253.17.1
DNS=100.100.100.100
User=1000:1000
UIDMap=+u1000:@51440:1
GIDMap=+g1000:@52000:1
GroupAdd=keep-groups
HealthCmd=none
NoNewPrivileges=true
DropCapability=NET_RAW

Environment=TZ=America/Chicago
Environment=NAS_SABNZBD_ALLOWED_HOSTNAMES=sabnzbd.i.samhclark.com,sabnzbd.krun
Environment=NAS_SABNZBD_COMPLETED_PERMISSIONS=2770

# Image-controlled libkrun entrypoint adapter (read-only)
Volume=/usr/share/nas/sabnzbd:/usr/share/nas/sabnzbd:ro

# Declarative config storage
Volume=/var/lib/sabnzbd/config:/config

# Shared fleet resource media
Volume=/var/zfs/tank/videos/data/usenet:/data/usenet

[Service]
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStartPre=/usr/bin/bash -ceu 'for i in {1..90}; do if /usr/bin/test -r /run/nas-krun-network/policy-ready && /usr/bin/test -e /sys/class/net/krun-51440; then exit 0; fi; sleep 1; done; echo "krun network policy was not ready within 90 seconds" >&2; exit 1'
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-egress/mullvad/ready 60 1
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-storage/sabnzbd/ready 300 2 --path /var/lib/sabnzbd/config --source tank/sabnzbd/config --owner 51440:51440 --access rwx
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-storage/media/ready 300 2 --path /var/zfs/tank/videos/data/usenet --source tank/videos --access rwx
ExecStartPost=/usr/bin/bash -ceu 'for i in {1..300}; do if /usr/bin/timeout 1 /usr/bin/bash -c "</dev/tcp/10.253.17.2/8080" >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo "libkrun guest 10.253.17.2:8080 was not reachable" >&2; exit 1'
Restart=always
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=default.target

[Unit]
Description=SABnzbd Usenet Downloader
Documentation=https://sabnzbd.org/

[Container]
ContainerName=sabnzbd
Image=lscr.io/linuxserver/sabnzbd:5.1.0-ls266@sha256:b0f9755d795913bd26ae3f3a12805668ab0681ab847a7624568559c573fc7cae
LogDriver=journald
Entrypoint=/usr/share/nas/sabnzbd/sabnzbd-entrypoint.sh
PodmanArgs=--runtime=krun
Annotation=krun.cpus=2
Annotation=krun.ram_mib=2048
Annotation=krun.tap_name=krun-51440
StopSignal=SIGINT
Network=host
AddDevice=/dev/net/tun
AddHost=garage.krun:10.253.1.2
AddHost=jellyfin.krun:10.253.2.2
AddHost=immich-server.krun:10.253.10.2

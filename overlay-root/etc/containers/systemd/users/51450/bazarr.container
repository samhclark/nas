[Unit]
Description=Bazarr Subtitle Automation
Documentation=https://wiki.bazarr.media/

[Container]
ContainerName=bazarr
Image=ghcr.io/linuxserver/bazarr:v1.6.2-ls373@sha256:e0c5d45965242830c5eeddaafe9ae2b5e8ca3f6c01ecda9ee9364f550921dc50
LogDriver=journald
Entrypoint=/usr/share/nas/bazarr/bazarr-entrypoint.sh
PodmanArgs=--runtime=krun
Annotation=krun.cpus=2
Annotation=krun.ram_mib=1024
Annotation=krun.tap_name=krun-51450
StopSignal=SIGINT
Network=host
AddDevice=/dev/net/tun
AddHost=garage.krun:10.253.1.2
AddHost=jellyfin.krun:10.253.2.2
AddHost=immich-server.krun:10.253.10.2

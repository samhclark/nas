AddHost=host.krun.internal:10.253.20.1
DNS=100.100.100.100
User=1000:1000
UIDMap=+u1000:@51450:1
GIDMap=+g1000:@52000:1
GroupAdd=keep-groups
HealthCmd=none
NoNewPrivileges=true
DropCapability=NET_RAW

Environment=TZ=America/Chicago

# Image-controlled libkrun entrypoint adapter (read-only)
Volume=/usr/share/nas/bazarr:/usr/share/nas/bazarr:ro

# Declarative config storage
Volume=/var/lib/bazarr/config:/config

# Shared fleet resource media
Volume=/var/zfs/tank/videos/data/media:/data/media

[Service]
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStartPre=/usr/bin/bash -ceu 'for i in {1..90}; do if /usr/bin/test -r /run/nas-krun-network/policy-ready && /usr/bin/test -e /sys/class/net/krun-51450; then exit 0; fi; sleep 1; done; echo "krun network policy was not ready within 90 seconds" >&2; exit 1'
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-egress/mullvad/ready 60 1
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-storage/bazarr/ready 300 2 --path /var/lib/bazarr/config --source tank/bazarr/config --owner 51450:51450 --access rwx
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-storage/media/ready 300 2 --path /var/zfs/tank/videos/data/media --source tank/videos --access rwx
ExecStartPost=/usr/bin/bash -ceu 'for i in {1..300}; do if /usr/bin/timeout 1 /usr/bin/bash -c "</dev/tcp/10.253.20.2/6767" >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo "libkrun guest 10.253.20.2:6767 was not reachable" >&2; exit 1'
Restart=always
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=default.target

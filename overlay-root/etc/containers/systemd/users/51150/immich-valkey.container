[Unit]
Description=Immich Valkey Queue and Cache
Documentation=https://valkey.io/

[Container]
ContainerName=immich-valkey
Image=docker.io/valkey/valkey:9.1.1@sha256:3acc0687f2a2e1091fae6450d7842dd658c941338cf0a873ddd9e14b9e4ea4dd
LogDriver=journald
Entrypoint=valkey-server
PodmanArgs=--runtime=krun
Annotation=krun.cpus=1
Annotation=krun.ram_mib=512
Annotation=krun.tap_name=krun-51150
StopSignal=SIGINT
Network=host
AddDevice=/dev/net/tun
AddHost=garage.krun:10.253.1.2
AddHost=jellyfin.krun:10.253.2.2

# Declarative data storage
Volume=/var/lib/immich/valkey:/data

Exec=--port 6379

[Service]
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStartPre=/usr/bin/bash -ceu 'for i in {1..90}; do if /usr/bin/test -r /run/nas-krun-network/policy-ready && /usr/bin/test -e /sys/class/net/krun-51150; then exit 0; fi; sleep 1; done; echo "krun network policy was not ready within 90 seconds" >&2; exit 1'
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-storage/immich-valkey/ready 300 2 --path /var/lib/immich/valkey --owner 51150:51150 --access rwx
ExecStartPost=/usr/bin/bash -ceu 'for i in {1..30}; do if /usr/bin/timeout 1 /usr/bin/bash -c "</dev/tcp/10.253.12.2/6379" >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo "libkrun guest 10.253.12.2:6379 was not reachable" >&2; exit 1'
Restart=always
RestartSec=30
TimeoutStartSec=330

[Install]
WantedBy=default.target

ExecStartPost=/usr/bin/bash -ceu 'for i in {1..30}; do if /usr/bin/timeout 1 /usr/bin/bash -c "</dev/tcp/10.253.7.2/8428" >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo "libkrun guest 10.253.7.2:8428 was not reachable" >&2; exit 1'
Restart=always

[Unit]
Description=Prowlarr Indexer Management
Documentation=https://prowlarr.com/

[Container]
ContainerName=prowlarr
Image=lscr.io/linuxserver/prowlarr:2.5.2.5491-ls156@sha256:1295cff29d10b486c0d8324d1559a552140a5932bf8b3d87e398654414f63f92
LogDriver=journald
Entrypoint=/usr/share/nas/prowlarr/prowlarr-entrypoint.sh
PodmanArgs=--runtime=krun
Annotation=krun.cpus=1
Annotation=krun.ram_mib=512
Annotation=krun.tap_name=krun-51430
StopSignal=SIGINT
Network=host
AddDevice=/dev/net/tun
AddHost=garage.krun:10.253.1.2
AddHost=jellyfin.krun:10.253.2.2
AddHost=immich-server.krun:10.253.10.2

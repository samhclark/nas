AddHost=host.krun.internal:10.253.16.1
DNS=100.100.100.100
User=1000:1000
UIDMap=+u1000:@51430:1
GIDMap=+g1000:@51430:1
HealthCmd=none
NoNewPrivileges=true
DropCapability=NET_RAW

Environment=TZ=America/Chicago
Environment=TMPDIR=/tmp
Environment=PROWLARR__LOG__CONSOLEFORMAT=Clef

# Image-controlled libkrun entrypoint adapter (read-only)
Volume=/usr/share/nas/prowlarr:/usr/share/nas/prowlarr:ro

# Declarative config storage
Volume=/var/lib/prowlarr/config:/config

[Service]
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStartPre=/usr/bin/bash -ceu 'for i in {1..90}; do if /usr/bin/test -r /run/nas-krun-network/policy-ready && /usr/bin/test -e /sys/class/net/krun-51430; then exit 0; fi; sleep 1; done; echo "krun network policy was not ready within 90 seconds" >&2; exit 1'
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-egress/mullvad/ready 60 1
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-storage/prowlarr/ready 300 2 --path /var/lib/prowlarr/config --source tank/prowlarr/config --owner 51430:51430 --access rwx
ExecStartPost=/usr/bin/bash -ceu 'for i in {1..300}; do if /usr/bin/timeout 1 /usr/bin/bash -c "</dev/tcp/10.253.16.2/9696" >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo "libkrun guest 10.253.16.2:9696 was not reachable" >&2; exit 1'
Restart=always
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=default.target

[Unit]
Description=Radarr Movie Library Automation
Documentation=https://radarr.video/

[Container]
ContainerName=radarr
Image=lscr.io/linuxserver/radarr:6.3.0.10514-ls313@sha256:a45b5ab0f850f39edb4cc9c95bbd967b52ddc3d4574a4dfb45561177db6c88f4
LogDriver=journald
Entrypoint=/usr/share/nas/radarr/radarr-entrypoint.sh
PodmanArgs=--runtime=krun
Annotation=krun.cpus=2
Annotation=krun.ram_mib=4096
Annotation=krun.tap_name=krun-51420
StopSignal=SIGINT
Network=host
AddDevice=/dev/net/tun
AddHost=garage.krun:10.253.1.2
AddHost=jellyfin.krun:10.253.2.2
AddHost=immich-server.krun:10.253.10.2
AddHost=immich-database.krun:10.253.11.2
AddHost=immich-valkey.krun:10.253.12.2
AddHost=immich-machine-learning.krun:10.253.13.2
AddHost=grafana.krun:10.253.3.2
AddHost=vmalert.krun:10.253.4.2
AddHost=blackbox-exporter.krun:10.253.5.2
AddHost=alertmanager.krun:10.253.6.2
AddHost=victoria-metrics.krun:10.253.7.2
AddHost=jellyfin-exporter.krun:10.253.8.2
AddHost=victoria-logs.krun:10.253.18.2
AddHost=caddy.krun:10.253.9.2
AddHost=sonarr.krun:10.253.14.2
AddHost=radarr.krun:10.253.15.2
AddHost=prowlarr.krun:10.253.16.2
AddHost=sabnzbd.krun:10.253.17.2
AddHost=host.krun.internal:10.253.15.1
DNS=100.100.100.100
User=1000:1000
UIDMap=+u1000:@51420:1
GIDMap=+g1000:@52000:1
GroupAdd=keep-groups
HealthCmd=none
NoNewPrivileges=true
DropCapability=NET_RAW

Environment=TZ=America/Chicago
Environment=TMPDIR=/tmp
Environment=RADARR__LOG__CONSOLEFORMAT=Clef

# Image-controlled libkrun entrypoint adapter (read-only)
Volume=/usr/share/nas/radarr:/usr/share/nas/radarr:ro

# Declarative config storage
Volume=/var/lib/radarr/config:/config

# Shared fleet resource media
Volume=/var/zfs/tank/videos/data:/data

[Service]
ExecStartPre=/usr/bin/test -c /dev/net/tun
ExecStartPre=/usr/bin/bash -ceu 'for i in {1..90}; do if /usr/bin/test -r /run/nas-krun-network/policy-ready && /usr/bin/test -e /sys/class/net/krun-51420; then exit 0; fi; sleep 1; done; echo "krun network policy was not ready within 90 seconds" >&2; exit 1'
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-egress/mullvad/ready 60 1
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-storage/radarr/ready 300 2 --path /var/lib/radarr/config --source tank/radarr/config --owner 51420:51420 --access rwx
ExecStartPre=/usr/local/bin/nas-wait-for-readiness.sh marker /run/nas-storage/media/ready 300 2 --path /var/zfs/tank/videos/data --source tank/videos --access rwx
ExecStartPost=/usr/bin/bash -ceu 'for i in {1..300}; do if /usr/bin/timeout 1 /usr/bin/bash -c "</dev/tcp/10.253.15.2/7878" >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo "libkrun guest 10.253.15.2:7878 was not reachable" >&2; exit 1'
Restart=always
RestartSec=30
TimeoutStartSec=900

[Install]
WantedBy=default.target

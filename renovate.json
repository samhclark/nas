{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "custom.regex",
    "github-actions"
  ],
  "gitIgnoredAuthors": [
    "/^[0-9]+\\+samhclark-nas-quadlets\\[bot\\]@users\\.noreply\\.github\\.com$/"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Vector runtime and license images",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "FROM\\s+(?<depName>docker\\.io/timberio/vector):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+-(?:distroless-static|debian))@(?<currentDigest>sha256:[a-f0-9]+)\\s+AS\\s+vector(?:-license)?\\b"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update rootless Quadlet container images",
      "managerFilePatterns": [
        "/^quadlets\\/[^/]+\\.toml$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"@]+):(?<currentValue>[^\"@:]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the SOPS build-stage image",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "FROM\\s+(?<depName>ghcr\\.io/getsops/sops):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\\s+[aA][sS]\\s+sops"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the Butane validation image",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "BUTANE_IMAGE\\s*\\?=\\s*(?<depName>quay\\.io/coreos/butane):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the ShellCheck validation image",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "SHELLCHECK_IMAGE\\s*\\?=\\s*(?<depName>docker\\.io/koalaman/shellcheck):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the Vector runtime and license material on the same release",
      "matchPackageNames": [
        "docker.io/timberio/vector"
      ],
      "groupName": "Vector"
    },
    {
      "description": "Track stable Jellyfin releases across the change from three-part to two-part versions",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/jellyfin/jellyfin"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?$"
    },
    {
      "description": "Track stable LinuxServer app versions and image rebuilds without freezing the ls suffix",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/prowlarr"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "Track stable SABnzbd versions and LinuxServer image rebuilds",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/sabnzbd"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Track stable Bazarr versions and LinuxServer image rebuilds",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/linuxserver/bazarr"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Wait three days before proposing version updates",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "prCreation": "immediate",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Explain generated Quadlet updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "quadlets/*.toml"
      ],
      "prBodyNotes": [
        "The Generate Renovate Quadlets workflow commits generated units to this branch for image-only updates. Review both the source pins and generated units before merging."
      ]
    },
    {
      "description": "Keep VictoriaMetrics components on the same release",
      "matchPackageNames": [
        "docker.io/victoriametrics/victoria-metrics",
        "docker.io/victoriametrics/vmalert"
      ],
      "groupName": "VictoriaMetrics components"
    }
  ]
}
